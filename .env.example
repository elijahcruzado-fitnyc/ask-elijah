# Create a key at vercel.com → AI Gateway → API Keys, then copy this file to
# .env.local and paste it in. Never commit .env.local.
AI_GATEWAY_API_KEY=

# Optional: override the model (default google/gemini-2.5-flash-lite).
# ASK_ELIJAH_MODEL=

# Local testing only: 1 swaps in a scripted model. Never set this on Vercel.
# ASK_ELIJAH_MOCK=1
